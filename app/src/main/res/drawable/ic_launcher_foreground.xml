        android:strokeColor="#93C5FD"
        android:fillColor="#00000000" />

    <!-- أعمدة إحصائيات المراقبة الذكية (Monitoring Analytics Bars) داخل الدرع -->
    <!-- العمود 1: اليسار -->
    <path
        android:pathData="M48,58 L48,52"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#BAE6FD" />

    <!-- العمود 2: الوسط (القمة) -->
    <path
        android:pathData="M54,58 L54,46"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- العمود 3: اليمين -->
    <path
        android:pathData="M60,58 L60,49"
