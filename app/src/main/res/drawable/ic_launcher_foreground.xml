        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- نقطة البداية المضيئة لحلقة الوقت -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M32,40m-2.2,0a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0" />

    <!-- درع الحماية والمراقبة المركزي (Central Shield) -->
    <path
        android:pathData="M54,37 C61,37 68,39 68,48 C68,58.5 59.5,67 54,70 C48.5,67 40,58.5 40,48 C40,39 47,37 54,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="37"
                android:endX="68"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#1D4ED8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- إطار الدرع الخفيف -->
    <path
        android:pathData="M54,37 C61,37 68,39 68,48 C68,58.5 59.5,67 54,70 C48.5,67 40,58.5 40,48 C40,39 47,37 54,37 Z"
